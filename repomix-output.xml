import type{Env,Owner}from"../types";import{json}from"../types";
export async function sessionRoutes(req:Request,env:Env,o:Owner){const p=new URL(req.url).pathname;if(p==="/api/sessions"&&req.method==="GET"){const x=await env.DB.prepare("SELECT id,title,target_repo,target_branch,updated_at FROM sessions WHERE user_id=? ORDER BY updated_at DESC LIMIT 50").bind(o.user_id).all();return json(x.results)}const m=p.match(/^\/api\/sessions\/([^/]+)$/);if(m&&req.method==="GET"){const s=await env.DB.prepare("SELECT * FROM sessions WHERE id=? AND user_id=?").bind(m[1],o.user_id).first();if(!s)return json({error:{code:"not_found",message:"Session not found."}},404);const runs=await env.DB.prepare("SELECT * FROM runs WHERE session_id=? ORDER BY created_at DESC").bind(m[1]).all();return json({session:s,runs:runs.results})}return null}
