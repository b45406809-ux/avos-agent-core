export async function requireCsrf(req:Request,env:Env){if(["GET","HEAD","OPTIONS"].includes(req.method))return;const origin=req.headers.get("origin"),expected=new URL(req.url).origin;if(origin!==expected)throw new ApiError(403,"origin_rejected","The request did not originate from this application.");const session=cookie(req,"avos_session"),token=req.headers.get("x-csrf-token");if(!session||!token)throw new ApiError(403,"csrf_rejected","A CSRF token is required.");const row=await env.DB.prepare("SELECT 1 ok FROM authenticated_sessions WHERE token_hash=? AND csrf_hash=? AND expires_at>?").bind(await sha256(session),await sha256(token),Date.now()).first();if(!row)throw new ApiError(403,"csrf_rejected","The CSRF token is invalid.")}
