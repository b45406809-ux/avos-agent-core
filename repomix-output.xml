import {sha256} from "../security";import {ApiError} from "./errors";import type{Env,Owner}from"../types";
export const cookie=(r:Request,n:string)=>r.headers.get("cookie")?.match(new RegExp(`(?:^|; )${n}=([^;]+)`))?.[1];
export async function requireOwner(req:Request,env:Env):Promise<Owner>{const token=cookie(req,"avos_session");if(!token)throw new ApiError(401,"authentication_required","Sign in with the configured owner GitHub account.");const row=await env.DB.prepare("SELECT s.user_id,u.organization_id,u.external_subject github_id FROM authenticated_sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND s.expires_at>?").bind(await sha256(token),Date.now()).first<Owner>();if(!row||row.github_id!==String(env.OWNER_GITHUB_ID))throw new ApiError(401,"authentication_required","Your session is invalid or expired.");return row}
export async function requireLease(req:Request,env:Env){const token=req.headers.get("authorization")?.match(/^Bearer (.+)$/)?.[1];if(!token)throw new ApiError(401,"runner_lease_required","A valid runner lease is required.");const row=await env.DB.prepare("SELECT * FROM runner_leases WHERE (token_hash=? OR (previous_token_hash=? AND overlap_until>?)) AND revoked_at IS NULL AND expires_at>?").bind(await sha256(token),await sha256(token),Date.now(),Date.now()).first<any>();if(!row)throw new ApiError(401,"runner_lease_invalid","The runner lease is invalid or expired.");return row}
export async function revokeRunLeases(env:Env,runId:string){await env.DB.prepare("UPDATE runner_leases SET revoked_at=? WHERE run_id=? AND revoked_at IS NULL").bind(Date.now(),runId).run()}
