              <input type="text" id="target_repo" placeholder="owner/repo">
            </div>
            <div class="form-group">
              <label for="target_branch">Target Branch</label>
              <input type="text" id="target_branch" value="main">
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="section-heading">Swarm Parameters</div>
          <div class="form-row">
            <div class="form-group">
              <label for="execution_mode">Execution Mode</label>
              <select id="execution_mode">
                <option value="single">Single-Agent ReAct (Focused)</option>
                <option value="swarm">Topological Swarm (Parallel DAG)</option>
              </select>
            </div>
            <div class="form-group">
              <label for="create_pr">Publish Action</label>
              <select id="create_pr">
                <option value="false">Direct Commit &amp; Push</option>
                <option value="true">Create Pull Request (PR)</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="max_workers">Worker Concurrency</label>
              <input type="number" id="max_workers" value="4" min="1" max="16">
            </div>
            <div class="form-group">
              <label for="max_budget_tokens">Budget Safeguard (Tokens)</label>
              <input type="number" id="max_budget_tokens" value="8000000" step="500000">
            </div>
          </div>
        </div>

        <div class="form-section">
