import{ApiError}from"./errors";import type{Env}from"../types";
export async function rateLimit(env:Env,bucket:string,limit=30){const n=Date.now(),reset=n+60000,row=await env.DB.prepare("SELECT count,reset_at FROM rate_limits WHERE bucket=?").bind(bucket).first<any>();if(row&&row.reset_at>n&&row.count>=limit)throw new ApiError(429,"rate_limited","Too many requests. Try again shortly.");await env.DB.prepare("INSERT INTO rate_limits(bucket,count,reset_at) VALUES(?,1,?) ON CONFLICT(bucket) DO UPDATE SET count=CASE WHEN reset_at<? THEN 1 ELSE count+1 END,reset_at=CASE WHEN reset_at<? THEN ? ELSE reset_at END").bind(bucket,reset,n,n,reset).run()}
