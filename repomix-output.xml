import{RunDispatch,PermissionDecisionBody,parse}from"@avos/protocol";import type{Env,Owner}from"../types";import{json}from"../types";import{readJson,ApiError}from"../middleware/errors";import{randomId,sanitize}from"../security";import{appendEvent}from"../services/events";import{revokeRunLeases}from"../middleware/auth";import{readiness}from"../services/setup";
async function owned(env:Env,id:string,o:Owner){const r=await env.DB.prepare("SELECT * FROM runs WHERE id=? AND user_id=?").bind(id,o.user_id).first<any>();if(!r)throw new ApiError(404,"run_not_found","Run not found.");return r}
export async function runRoutes(req:Request,env:Env,o:Owner){const u=new URL(req.url),p=u.pathname;if(p==="/api/runs/dispatch"&&req.method==="POST"){const setup=await readiness(env);if(!["ready","degraded"].includes(setup.status))throw new ApiError(409,"setup_required","Mission dispatch is disabled until setup is ready.");const b=parse(RunDispatch,await readJson(req)),m=await env.DB.prepare("SELECT * FROM missions WHERE id=? AND user_id=?").bind(b.missionId,o.user_id).first<any>();if(!m)throw new ApiError(404,"mission_not_found","Mission not found.");const id=randomId("run"),corr=randomId("correlation"),n=Date.now();await env.DB.batch([env.DB.prepare("INSERT INTO runs(id,mission_id,session_id,user_id,organization_id,target_repo,target_branch,execution_mode,status,correlation_id,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)").bind(id,m.id,b.sessionId,o.user_id,o.organization_id,b.repository,b.branch,"single","provisioning",corr,n,n),env.DB.prepare("INSERT INTO run_attachments(run_id,attachment_id) SELECT ?,attachment_id FROM mission_attachments WHERE mission_id=?").bind(id,m.id)]);await appendEvent(env,id,{eventType:"provisioning",payload:{summary:"Mission persisted; executor dispatch queued"}});await env.DISPATCH_QUEUE.send({runId:id,correlation:corr,environment:b.environment,protocolVersion:1});return json({runId:id,correlation:corr,status:"provisioning"},202)}
if(p==="/api/permissions/decision"&&req.method==="POST"){const b=parse(PermissionDecisionBody,await readJson(req)),pr=await env.DB.prepare("SELECT p.* FROM permission_requests p JOIN runs r ON r.id=p.run_id WHERE p.id=? AND r.user_id=?").bind(b.requestId,o.user_id).first<any>();if(!pr||pr.status!=="pending")throw new ApiError(409,"permission_not_pending","This permission request is no longer pending.");const cid=randomId("command"),n=Date.now();await env.DB.batch([env.DB.prepare("INSERT INTO permission_decisions(id,request_id,run_id,user_id,decision,idempotency_key,created_at) VALUES(?,?,?,?,?,?,?)").bind(randomId("decision"),pr.id,pr.run_id,o.user_id,b.decision,req.headers.get("idempotency-key")||randomId("idem"),n),env.DB.prepare("UPDATE permission_requests SET status=? WHERE id=? AND status='pending'").bind(b.decision,pr.id),env.DB.prepare("INSERT INTO run_commands(id,run_id,user_id,type,payload_json,idempotency_key,created_at) VALUES(?,?,?,?,?,?,?)").bind(cid,pr.run_id,o.user_id,"permission_decision",JSON.stringify(b),`permission:${pr.id}`,n)]);await appendEvent(env,pr.run_id,{eventType:"permission_decided",payload:b});return json({status:b.decision,commandId:cid})}
const m=p.match(/^\/api\/runs\/([^/]+)(?:\/(.+))?$/);if(!m)return null;const run=await owned(env,m[1],o),action=m[2];if(!action&&req.method==="GET"){const cursor=Number(u.searchParams.get("cursor")||0),events=await env.DB.prepare("SELECT * FROM events WHERE run_id=? AND sequence>? ORDER BY sequence").bind(run.id,cursor).all();return json({snapshot:{run},run,events:events.results})}if(action==="events"&&req.method==="GET"){const q=await env.DB.prepare("SELECT * FROM events WHERE run_id=? AND sequence>? ORDER BY sequence").bind(run.id,Number(u.searchParams.get("cursor")||0)).all();return json(q.results)}if(action==="live"&&req.headers.get("upgrade")==="websocket")return env.RUNS.get(env.RUNS.idFromName(run.id)).fetch(req);if(["cancel","follow-up","interrupt"].includes(action||"")&&req.method==="POST"){const b=sanitize(await readJson(req)),type=action==="follow-up"?"follow_up":action!,id=randomId("command");await env.DB.prepare("INSERT INTO run_commands(id,run_id,user_id,type,payload_json,idempotency_key,created_at) VALUES(?,?,?,?,?,?,?)").bind(id,run.id,o.user_id,type,JSON.stringify(b),req.headers.get("idempotency-key")||randomId("idem"),Date.now()).run();if(type==="cancel")await appendEvent(env,run.id,{eventType:"cancelling",payload:{summary:"Cancellation requested; runner shutdown command queued"}});return json({commandId:id,status:"accepted"},202)}if(action==="retry"&&req.method==="POST"){if(!run.checkpoint_id)throw new ApiError(409,"checkpoint_required","No checkpoint is available for continuation.");const id=randomId("run"),corr=randomId("correlation"),n=Date.now();await env.DB.prepare("INSERT INTO runs(id,mission_id,session_id,user_id,organization_id,target_repo,target_branch,execution_mode,status,correlation_id,parent_run_id,checkpoint_id,created_at,updated_at) SELECT ?,mission_id,session_id,user_id,organization_id,target_repo,target_branch,execution_mode,'provisioning',?,?,checkpoint_id,?,? FROM runs WHERE id=?").bind(id,corr,run.id,n,n,run.id).run();await revokeRunLeases(env,run.id);await env.DISPATCH_QUEUE.send({runId:id,correlation:corr,continuation:true});return json({runId:id,status:"provisioning"},202)}return null}
