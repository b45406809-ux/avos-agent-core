export async function missionRoutes(req:Request,env:Env,o:Owner){if(new URL(req.url).pathname!=="/api/missions"||req.method!=="POST")return null;const ready=await readiness(env);if(!["ready","degraded"].includes(ready.status))throw new ApiError(409,"setup_required","Complete GitHub and qualified model setup before creating a mission.");const b=parse(MissionCreate,await readJson(req)),size=new TextEncoder().encode(b.prompt).length,max=Number(env.MAX_PROMPT_BYTES||2097152);if(size>max)throw new ApiError(413,"prompt_size_limit",`Prompt is ${size} bytes; the configured limit is ${max}. Shorten it or move source material into the repository; no charge occurred.`);if(b.attachmentIds.length>20)throw new ApiError(413,"attachment_count_limit","A mission accepts at most 20 files; remove files and retry. No charge occurred.");const totals=await env.DB.prepare("SELECT COUNT(*) count,COALESCE(SUM(size_bytes),0) bytes FROM attachments WHERE user_id=? AND scan_status='validated' AND id IN (SELECT value FROM json_each(?))").bind(o.user_id,JSON.stringify(b.attachmentIds)).first<any>(),totalMax=Number(env.MAX_MISSION_ATTACHMENT_BYTES||52428800);if(totals.count!==b.attachmentIds.length||totals.bytes>totalMax)throw new ApiError(422,"mission_attachment_limit",`Validated mission attachments total ${totals.bytes} bytes; limit is ${totalMax}. Remove files and retry; no charge occurred.`);const mid=randomId("mission"),sid=b.sessionId||randomId("session"),n=Date.now(),doc=await putPrompt(env,o.user_id,mid,b.prompt);await env.DB.batch([env.DB.prepare("INSERT INTO sessions(id,user_id,organization_id,title,target_repo,target_branch,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET updated_at=excluded.updated_at").bind(sid,o.user_id,o.organization_id,b.prompt.slice(0,80),b.repository,b.branch,n,n),env.DB.prepare("INSERT INTO missions(id,user_id,organization_id,specification_json,specification_checksum,prompt_object_key,prompt_document_id,idempotency_key,created_at) VALUES(?,?,?,?,?,?,?,?,?)").bind(mid,o.user_id,o.organization_id,JSON.stringify({...b,prompt:undefined}),doc.checksum,doc.kv_key,doc.id,req.headers.get("idempotency-key")||randomId("idem"),n),env.DB.prepare("UPDATE documents SET mission_id=? WHERE id=?").bind(mid,doc.id),env.DB.prepare("INSERT INTO mission_attachments(mission_id,attachment_id) SELECT ?,id FROM attachments WHERE id IN (SELECT value FROM json_each(?)) AND user_id=? AND scan_status='validated'").bind(mid,JSON.stringify(b.attachmentIds),o.user_id)]);if(size>256000){const index=sections(b.prompt);await env.DB.batch(index.map(x=>env.DB.prepare("INSERT INTO requirements_index(mission_id,section_id,byte_offset,byte_length,heading) VALUES(?,?,?,?,?)").bind(mid,x.id,x.offset,x.length,x.heading)))}return json({id:mid,sessionId:sid,promptReference:{id:doc.id,checksum:doc.checksum,size,warning:size>256000?"Large prompt indexed; agents should retrieve relevant sections after normalization.":undefined,state:doc.state}},201)}
