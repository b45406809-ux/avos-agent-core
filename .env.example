# This repository is single-owner. Every fork MUST use its own immutable GitHub user ID.
OWNER_GITHUB_LOGIN=
OWNER_GITHUB_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_HMAC_KEY=
CONTROL_REPOSITORY=owner/avos-agent-core
CONTROL_REPOSITORY_DEFAULT_BRANCH=main
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WORKFLOW_REF=owner/avos-agent-core/.github/workflows/agent.yml@refs/heads/main
OIDC_AUDIENCE=avos-runner
CREDENTIAL_KEK=
REPOSITORY_ALLOWLIST=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Provider secrets belong in Cloudflare secrets or GitHub Actions secrets, never workflow inputs.
GEMINI_API_KEYS=
GROQ_API_KEYS=
CEREBRAS_API_KEYS=
OPENROUTER_API_KEYS=
NVIDIA_API_KEYS=
# Hard no-charge application guards (usage counters are estimates; Cloudflare is authoritative).
FREE_ONLY_MODE=true
MAX_KV_WRITES_PER_DAY=800
MAX_D1_WRITES_PER_DAY=80000
MAX_D1_ROWS_READ_PER_DAY=4000000
MAX_GITHUB_MINUTES_PER_MONTH=1500
MAX_ATTACHMENT_BYTES=20971520
MAX_MISSION_ATTACHMENT_BYTES=52428800
MAX_PROMPT_BYTES=2097152
TEMP_DOCUMENT_DAYS=10
ATTACHMENT_MIME_ALLOWLIST=
