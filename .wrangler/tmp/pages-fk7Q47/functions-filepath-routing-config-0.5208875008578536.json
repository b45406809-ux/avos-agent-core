      ]
    },
    {
      "routePath": "/api/events",
      "mountPath": "/api",
      "method": "OPTIONS",
      "module": [
        "api/events.js:onRequestOptions"
      ]
    },
    {
      "routePath": "/api/events",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/events.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/stream",
      "mountPath": "/api",
      "method": "GET",
      "module": [
